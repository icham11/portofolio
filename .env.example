# Environment Variables - Wahid Nurhisyam Portfolio
# Copy this file to .env and fill in the values

# -------------------------------
# DATABASE
# -------------------------------
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Provider: Neon, Supabase, Railway, or self-hosted PostgreSQL
# Pastikan pgvector extension sudah diaktifkan di database Anda
DATABASE_URL=
# -------------------------------
# AI - GROQ (Chat Streaming)
# -------------------------------
# Dapatkan dari: https://console.groq.com
GROQ_API_KEY=

# -------------------------------
# AI - GEMINI (RAG Embeddings)
# -------------------------------
# Dapatkan dari: https://ai.google.dev
GEMINI_API_KEY=

# -------------------------------
# IMAGEKIT (Asset Management)
# -------------------------------
# Dapatkan dari: https://imagekit.io
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# -------------------------------
# RESEND (Contact Form Email) - OPTIONAL
# -------------------------------
# Jika tidak diisi, form kontak tetap berfungsi tapi email tidak terkirim
# Dapatkan dari: https://resend.com
RESEND_API_KEY=

# Alamat email tujuan untuk notifikasi form kontak
CONTACT_EMAIL=

# -------------------------------
# APP CONFIG
# -------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Wahid Nurhisyam - Portfolio"
